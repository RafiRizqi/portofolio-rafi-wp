{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/proyek/",
      "destination": "/#rf-works",
      "permanent": false
    },
    {
      "source": "/proyek/:path*",
      "destination": "/#rf-works",
      "permanent": false
    },
    {
      "source": "/sertifikat/",
      "destination": "/#rf-credentials",
      "permanent": false
    },
    {
      "source": "/sertifikat/:path*",
      "destination": "/#rf-credentials",
      "permanent": false
    }
  ]
}
