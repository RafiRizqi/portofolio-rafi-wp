# Ignore everything by default except custom development code
*
!.gitignore
!README.md

# Allow wp-content traversal
!wp-content/
!wp-content/themes/
!wp-content/plugins/
!wp-content/uploads/

# Track our custom Child Theme
!wp-content/themes/hello-elementor-child/
!wp-content/themes/hello-elementor-child/**

# Track our custom Portfolio Core Plugin
!wp-content/plugins/rafi-portfolio-core/
!wp-content/plugins/rafi-portfolio-core/**

# Track custom compressed portfolio thumbnails
!wp-content/uploads/portfolio-thumbnails/
!wp-content/uploads/portfolio-thumbnails/**

# Track high-definition vector certificates & social share assets
!wp-content/uploads/2026/
!wp-content/uploads/2026/11/
!wp-content/uploads/2026/11/cert-*.svg
!wp-content/uploads/2026/11/cert-ketua-hima.svg
!wp-content/uploads/2026/11/og-preview-banner.jpg
!wp-content/uploads/2026/11/favicon-rafi.svg
!wp-content/uploads/2026/11/rafi-portrait-asli.jpg

# Track agent skills & guidance
!.agents/
!.agents/**

# Always ignore OS/editor/log clutter inside tracked folders
.DS_Store
Thumbs.db
*.log
node_modules/
